<% const redes = [
  ['facebook', 'Facebook', '<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"/>'],
  ['instagram', 'Instagram', '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2"/>'],
  ['linkedin', 'LinkedIn', '<path d="M4.5 9h3v11h-3zM6 3.8a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM10 9h2.9v1.5h.1c.4-.8 1.4-1.7 3-1.7 3.1 0 3.7 2 3.7 4.7V20h-3v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V20h-3z"/>'],
].filter(([chave]) => cfg[`social_${chave}`]); %>
<% if (redes.length) { %>
<ul class="redes <%= typeof classeRedes !== 'undefined' ? classeRedes : '' %>">
  <% for (const [chave, nome, icone] of redes) { %>
  <li><a href="<%= cfg[`social_${chave}`] %>" rel="noopener" target="_blank" aria-label="FoMerco no <%= nome %>" title="<%= nome %>"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><%- icone %></svg></a></li>
  <% } %>
</ul>
<% } %>
